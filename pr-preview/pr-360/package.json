{
  "name": "tandemonium",
  "version": "1.0.0",
  "description": "A Tandem Bicycle Physics Game",
  "author": "Pete Gordon",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "sync-controller-core": "node scripts/sync-controller-core.js",
    "check:controller-core": "node scripts/check-controller-core.js",
    "download-vendors": "node scripts/download-vendors.js",
    "build-desktop": "node scripts/build-desktop.js",
    "package": "electron-forge package --platform win32 --arch x64",
    "make": "electron-forge make --platform win32 --arch x64",
    "steamtest": "electron tools/steam-controller-test/main.js",
    "gamepadtest": "electron tools/gamepad-test/main.js",
    "gen-tourist-key": "node scripts/gen-tourist-key.js"
  },
  "dependencies": {
    "steamworks-ffi-node": "0.10.3",
    "three": "0.161.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "electron": "^33.2.1",
    "puppeteer": "^24.37.3"
  }
}
