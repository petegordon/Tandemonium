// ============================================================
// SteamPipe app build script — Tandemonium Playtest (4510250)
//
// Run via:
//   C:\steamcmd\steamcmd.exe +login <user> +run_app_build "<abs path>\steam\builds\app_build_4510250.vdf" +quit
//
// `contentroot` points at the local packaged Electron build. The
// `controller_config/game_actions_4510250.vdf` file inside that
// folder is the Steam Input action manifest we need to ship so
// Steam Input actually loads it (the local-file-in-install-dir
// trick alone isn't honored on current Steam).
//
// `setlive` is intentionally empty — uploading the build does NOT
// make it the live build automatically. We promote via Steamworks
// → SteamPipe → Builds → set the new build's branch to "default".
// ============================================================
"appbuild"
{
    "appid"           "4510250"
    "desc"            "Tandemonium Playtest dev build (Steam Input enabled)"
    "buildoutput"     "..\\..\\steam\\builds\\output"
    "contentroot"     "..\\..\\out\\Tandemonium-win32-x64"
    "setlive"         ""
    "preview"         "0"
    "local"           ""

    "depots"
    {
        "4510251"     "depot_build_4510251.vdf"
    }
}
