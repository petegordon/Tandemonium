// ============================================================
// SteamPipe depot build script — Tandemonium Playtest data depot
//
// Ships everything under `contentroot` (set in app_build_4510250.vdf,
// which points at out\Tandemonium-win32-x64) to depot 4510251.
// Excludes nothing for now — the Electron packaged output is already
// minimal. Add patterns to FileExclusion if/when we need to.
// ============================================================
"DepotBuildConfig"
{
    "DepotID"  "4510251"

    "FileMapping"
    {
        "LocalPath"   "*"
        "DepotPath"   "."
        "recursive"   "1"
    }
}
