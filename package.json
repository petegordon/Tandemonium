{
  "name": "tandemonium",
  "version": "1.0.0",
  "description": "A Tandem Bicycle Physics Game",
  "author": "Pete Gordon",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:demo": "electron . --demo",
    "sync-controller-core": "node scripts/sync-controller-core.js",
    "check:controller-core": "node scripts/check-controller-core.js",
    "smoke:controller-overlay": "node scripts/smoke-controller-overlay.mjs",
    "smoke:physics": "node scripts/smoke-physics-fx.mjs",
    "download-vendors": "node scripts/download-vendors.js",
    "build-desktop": "node scripts/build-desktop.js",
    "package": "electron-forge package --platform win32 --arch x64",
    "make": "electron-forge make --platform win32 --arch x64",
    "steamtest": "electron tools/steam-controller-test/main.js",
    "gamepadtest": "electron tools/gamepad-test/main.js",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "smoke": "node scripts/smoke-lobby.mjs",
    "smoke:insecure": "node scripts/smoke-lobby.mjs --insecure",
    "smoke:boot": "node scripts/smoke-boot-failure.mjs",
    "audit:first30": "node scripts/audit-first-30s.mjs",
    "smoke:ride": "node scripts/smoke-first-ride.mjs",
    "smoke:geese": "node scripts/smoke-goose-riders.mjs",
    "smoke:no-media": "node scripts/smoke-no-media.mjs",
    "smoke:crash": "node scripts/smoke-crash-beat.mjs",
    "smoke:tutorial-board": "node scripts/smoke-tutorial-board.mjs",
    "smoke:records": "node scripts/smoke-records.mjs",
    "smoke:seed": "node scripts/smoke-seed-plumbing.mjs",
    "smoke:ctas": "node scripts/smoke-demo-ctas.mjs",
    "smoke:daily": "node scripts/smoke-todays-road.mjs",
    "check:dashboard-sql": "node scripts/check-dashboard-sql.mjs",
    "smoke:ranked": "node scripts/smoke-ranked-run.mjs",
    "smoke:tutorial": "node scripts/smoke-tutorial-first.mjs",
    "smoke:lookahead": "node scripts/smoke-lookahead.mjs",
    "smoke:ping": "node scripts/smoke-sync-ping.mjs",
    "smoke:disruptions": "node scripts/smoke-disruptions.mjs",
    "gen-tourist-key": "node scripts/gen-tourist-key.js",
    "smoke:tourist": "node scripts/smoke-tourist-route.mjs && node scripts/smoke-tourist-coop.mjs",
    "smoke:layout": "node scripts/smoke-hud-layout.mjs",
    "smoke:slingshot": "node scripts/smoke-slingshot.mjs",
    "smoke:slingshot-aim": "node scripts/smoke-slingshot-aim.mjs",
    "smoke:edition": "node scripts/smoke-edition.mjs",
    "smoke:quality": "node scripts/smoke-quality-tiers.mjs",
    "smoke:economy": "node scripts/smoke-economy.mjs",
    "smoke:achievements": "node scripts/smoke-achievements.mjs",
    "smoke:helping-hand": "node scripts/smoke-helping-hand.mjs",
    "sync-ui": "node scripts/sync-ui.js",
    "check:ui": "node scripts/check-ui.js",
    "docs:screen-flow": "node scripts/gen-screen-flow.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "smoke:phone-pad": "node scripts/smoke-phone-pad.mjs",
    "smoke:disconnect": "node scripts/smoke-disconnect-pause.mjs",
    "smoke:host-room": "node scripts/smoke-host-room.mjs",
    "smoke:local-coop": "node scripts/smoke-local-coop.mjs",
    "smoke:versus": "node scripts/smoke-versus.mjs",
    "smoke:webhid": "node scripts/smoke-webhid.mjs",
    "smoke:flows": "node scripts/smoke-flows.mjs",
    "smoke:steam-input": "node scripts/smoke-steam-input.mjs",
    "smoke:grandma": "node scripts/smoke-grandma-finish.mjs",
    "smoke:input": "node scripts/smoke-input.mjs",
    "smoke:options": "node scripts/smoke-options.mjs",
    "smoke:lobby-layout": "node scripts/smoke-lobby-layout.mjs",
    "smoke:online": "node scripts/smoke-online.mjs",
    "smoke:phone-coop": "node scripts/smoke-phone-coop.mjs",
    "smoke:solo-extras": "node scripts/smoke-solo-extras.mjs",
    "smoke:props": "node scripts/smoke-props-3d.mjs",
    "smoke:all": "node scripts/run-smokes.mjs"
  },
  "dependencies": {
    "steamworks-ffi-node": "0.10.3",
    "three": "0.161.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "electron": "^33.2.1",
    "puppeteer": "^24.37.3"
  }
}
