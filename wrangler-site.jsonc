{
  // The web game's static files on Cloudflare. Only staging is deployed for now;
  // production stays on GitHub Pages until the move. Build: npm run build:staging.
  "name": "tandemonium-site",
  "account_id": "87260c174f34fc18e96f2f47344e8d26",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "staging": {
      "name": "tandemonium-site-staging",
      "routes": [{ "pattern": "tandemonium-staging.housetandem.com", "custom_domain": true }],
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "./public",
        "html_handling": "auto-trailing-slash"
      }
    }
  }
}
