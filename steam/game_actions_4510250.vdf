// Steam Input action manifest - Tandemonium (playtest app 4510250)
// Ships in the depot at controller_config/game_actions_4510250.vdf and is
// registered server-side via Steamworks > App > Controller > Steam Input
// Default Controller Configuration > Custom Configuration > path field.
// Keep this file pure ASCII - Steam's VDF parser is strict.
//
// Hail-mary: added a dummy 'Confirm' Button action alongside Steer, in case
// Steam silently rejects action sets that only declare one StickPadGyro
// action with no Button entries. We don't read Confirm from the API; it's
// only here to give the action set a multi-category structure.

"In Game Actions"
{
	"actions"
	{
		"InGameControls"
		{
			"title"		"#Set_InGameControls"
			"StickPadGyro"
			{
				"Steer"
				{
					"title"			"#Action_Steer"
					"input_mode"	"joystick_move"
				}
			}
			"Button"
			{
				"Confirm"
				{
					"title"		"#Action_Confirm"
				}
			}
		}
	}
	"localization"
	{
		"english"
		{
			"Set_InGameControls"	"Gameplay"
			"Action_Steer"			"Steer"
			"Action_Confirm"		"Confirm"
		}
	}
}
